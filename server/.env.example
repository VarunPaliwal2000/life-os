# Environment Variables for Life OS Backend (Render)

# Server Port (Render assigns automatically, but shown here for reference)
# Leave empty on Render dashboard - it assigns a random port
PORT=4000

# Node Environment
# Set to "production" in Render
NODE_ENV=development

# MongoDB Connection String
# Get this from MongoDB Atlas → Connect → Connection String
# Replace <username>, <password>, <cluster-name> with your actual values
MONGODB_URI=mongodb+srv://username:password@cluster-name.mongodb.net/life-os?retryWrites=true&w=majority&authSource=admin

# CORS Origins (comma-separated list)
# In development: http://localhost:5173 (Vite default)
# In production: https://your-app.vercel.app (replace with your Vercel URL)
CORS_ORIGINS=http://localhost:5173
