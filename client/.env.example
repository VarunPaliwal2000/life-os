# Environment Variables for Life OS Frontend (Vercel)

# Node Environment
# Set to "production" in Vercel dashboard
NODE_ENV=development

# Backend API URL (used in production)
# In development: /api (uses Vite proxy to localhost:4000)
# In production: https://your-api.onrender.com (replace with your Render URL)
# Only needed if NODE_ENV=production, but safe to set always
VITE_API_URL=http://localhost:4000
